# Public client configuration only. Never put a service-role key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional deep-link destination for email sign-in.
EXPO_PUBLIC_AUTH_REDIRECT_URL=monkeytracker://auth/callback
