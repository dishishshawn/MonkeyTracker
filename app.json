{
  "expo": {
    "name": "Monkey Tracker",
    "slug": "monkey-tracker",
    "scheme": "monkeytracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F6F1E7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.monkeytracker.mobile"
    },
    "android": {
      "package": "app.monkeytracker.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F6F1E7"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Monkey Tracker uses a photo only when you choose to send a private postcard to your paired monkey.",
          "cameraPermission": false
        }
      ]
    ]
  }
}
