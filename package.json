{
  "name": "monkey-tracker",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "emulator": "bash scripts/android-emulator.sh",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "backend:lint": "supabase db lint",
    "backend:push": "supabase db push",
    "backend:verify-hosted": "node --env-file-if-exists=.env scripts/verify-hosted.mjs",
    "test": "vitest run",
    "verify": "bash scripts/check.sh"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.13",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@supabase/supabase-js": "^2.112.4",
    "expo": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "~19.2.2",
    "supabase": "^2.116.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
